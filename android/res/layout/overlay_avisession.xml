<?xml version="1.0" encoding="utf-8"?>
<!-- SESI ASISTEN AVI — DISKONTEK PERSIS UI GOOGLE ASSISTANT SAAT TAHAN
     TOMBOL HOME (b18, permintaan pemilik: "ringkas seperti Google").

     Yang ADA di Google dan sekarang ada di sini:
     - lapisan gelap transparan MEMENUHI LAYAR (bukan kartu mengapung);
     - greeting kiri ATAS: "Hai, [nama]" + "Ada yang bisa saya bantu?";
     - transkrip + jawaban sebagai teks polos di KIRI TENGAH;
     - EMPAT TITIK warna di KIRI BAWAH yang hidup saat bekerja;
     - status kecil di samping titik; tombol tutup kecil kanan atas;
     - usap ke bawah = tutup (pola Google).

     Yang TIDAK ada lagi (biar ringan & persis Google):
     - tanpa kartu mengapung 28dp, tanpa gagang genggam;
     - tanpa orb gradien 100dp berputar 60fps di tengah;
     - tanpa papan riwayat di panel — papan tunggal hidup di aplikasi AVI.

     Root menelan semua sentuhan (ketuk area kosong TIDAK menutup — sama
     seperti Google); menutup hanya lewat tombol ✕, usap ke bawah, atau
     AVI tidur sendiri saat hening.-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/akarSesi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EC0B1220"
    android:clickable="true"
    android:focusable="true">

    <!-- ===== greeting kiri atas ala "Hi, how can I help?" ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="26dp"
        android:paddingRight="66dp"
        android:paddingTop="46dp">

        <TextView
            android:id="@+id/tvSapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hai!"
            android:textColor="@color/sesi_teks"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Ada yang bisa saya bantu?"
            android:textColor="@color/sesi_samping"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- tombol tutup kecil kanan atas -->
    <FrameLayout
        android:id="@+id/btnTutupSesi"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="34dp"
        android:layout_marginRight="22dp"
        android:background="@drawable/pil_tutup"
        android:contentDescription="Tutup">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_tutup"
            android:contentDescription=""/>
    </FrameLayout>

    <!-- ===== transkrip + jawaban: teks polos kiri tengah ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="26dp"
        android:paddingRight="26dp">

        <TextView
            android:id="@+id/tvAndaSesi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="3"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvAviSesi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:textColor="#DCE7F8"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.35"
            android:maxLines="8"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- ===== bar bawah: 4 titik AVI + status ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="26dp"
        android:paddingRight="26dp"
        android:paddingBottom="44dp">

        <com.avi.assistant.TitikEmpat
            android:id="@+id/titikSesi"
            android:layout_width="64dp"
            android:layout_height="26dp"/>

        <TextView
            android:id="@+id/tvStatusSesi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/sesi_aksen"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- petunjuk halus -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:text="Usap ke bawah untuk menutup"
        android:textColor="@color/sesi_samping"
        android:textSize="10sp"
        android:letterSpacing="0.05"/>
</FrameLayout>
