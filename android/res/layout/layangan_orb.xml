<?xml version="1.0" encoding="utf-8"?>
<!--
    ORB MELAYANG — gelembung kecil AVI yang hidup DI ATAS aplikasi lain
    (jendela SYSTEM_ALERT_WINDOW milik OrbLayanan). Dapat digeser;
    diketuk = membuka lembar obrolan; ditahan = AVI pamit & orb ditutup.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/akarOrbMelayang"
    android:layout_width="58dp"
    android:layout_height="58dp">

    <com.avi.assistant.OrbView
        android:id="@+id/orbMelayang"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center"/>
</FrameLayout>
