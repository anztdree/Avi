<?xml version="1.0" encoding="utf-8"?>
<!--
    ORB MELAYANG — gelembung kecil AVI yang hidup DI ATAS aplikasi lain
    (jendela SYSTEM_ALERT_WINDOW milik OrbLayanan). Dapat digeser;
    diketuk = membuka lembar obrolan; ditahan 1,2 dtk = AVI pamit.

    b16: badan orb kini BADGE PADAT (orb_melayang_badge — cakram gelap +
    cincin sian) supaya terlihat jelas di wallpaper/aplikasi APA PUN;
    dulu hanya pendaran transparan 58dp yang nyaris tak terlihat
    ("floating tidak jelas sama sekali" — keluhan pemilik).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/akarOrbMelayang"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:background="@drawable/orb_melayang_badge">

    <com.avi.assistant.OrbView
        android:id="@+id/orbMelayang"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"/>
</FrameLayout>
