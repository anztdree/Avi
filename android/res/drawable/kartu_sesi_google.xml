<?xml version="1.0" encoding="utf-8"?>
<!-- KARTU SESI ala GOOGLE ASSISTANT (b17): kartu mengapung bersudut
     28dp di SEMUA sisi (dulu: lembar menempel dasar, hanya sudut atas
     bulat). Kaca gelap bergradasi — aplikasi di bawah tetap terlihat. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF12244A"
        android:centerColor="#F90B1A33"
        android:endColor="#F6050A14"/>
    <corners android:radius="28dp"/>
    <stroke android:width="1dp" android:color="@color/sesi_garis"/>
</shape>
